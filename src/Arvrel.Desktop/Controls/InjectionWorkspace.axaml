<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arvrel.Desktop.ViewModels"
             x:Class="Arvrel.Desktop.Controls.InjectionWorkspace"
             x:DataType="vm:MainWindowViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <UserControl.Styles>
    <Style Selector="Border.injectionCard">
      <Setter Property="Background" Value="#F8FAFB" />
      <Setter Property="BorderBrush" Value="#CBD6DC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="TextBlock.injectionLabel">
      <Setter Property="Foreground" Value="#667C87" />
      <Setter Property="FontSize" Value="8.8" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.injectionValue">
      <Setter Property="Foreground" Value="#233A45" />
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="10.2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.injectionEditor">
      <Setter Property="MinHeight" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="10.2" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.injectionAction">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="10.2" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="4,8,4,4"
        RowDefinitions="Auto,7,*,7,Auto">
    <Border Grid.Row="0"
            Classes="injectionCard"
            Padding="11,9">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2"
                    VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <TextBlock Text="ADVANCED INJECTION LABORATORY"
                       Foreground="#213945"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <Border Padding="7,2"
                    CornerRadius="4"
                    Background="#DDEEF7"
                    BorderBrush="#A9CDDF"
                    BorderThickness="1">
              <TextBlock Text="DIRECT"
                         Foreground="#216D95"
                         FontSize="8.7"
                         FontWeight="Bold" />
            </Border>
            <Border Padding="7,2"
                    CornerRadius="4"
                    Background="#E7F5EB"
                    BorderBrush="#B6D9C0"
                    BorderThickness="1">
              <TextBlock Text="{Binding OutputStateText}"
                         Foreground="#287544"
                         FontSize="8.7"
                         FontWeight="Bold" />
            </Border>
          </StackPanel>
          <TextBlock Text="Virtual secondary-injection workspace · editable 4I + 4V"
                     Foreground="#71858F"
                     FontSize="9.5" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <StackPanel Width="180" Spacing="3">
            <TextBlock Classes="injectionLabel" Text="PRESET" />
            <ComboBox ItemsSource="{Binding PresetNames}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                      MinHeight="30" />
          </StackPanel>
          <StackPanel Width="82" Spacing="3">
            <TextBlock Classes="injectionLabel" Text="FREQ Hz" />
            <TextBox Text="{Binding FrequencyText, Mode=TwoWay}"
                     MinHeight="30"
                     HorizontalContentAlignment="Right" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Classes="injectionCard"
            Padding="0">
      <Grid RowDefinitions="34,*">
        <Border Background="#EAF0F3"
                BorderBrush="#C8D4DA"
                BorderThickness="0,0,0,1"
                Padding="8,0">
          <Grid ColumnDefinitions="42,126,112,104,62,*"
                ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="injectionLabel" Text="EN" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="injectionLabel" Text="SIGNAL" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="injectionLabel" Text="RMS" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="injectionLabel" Text="ANGLE°" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="injectionLabel" Text="UNIT" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="5" Classes="injectionLabel" Text="PROVENANCE / MAPPING" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding InjectionChannels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InjectionChannelViewModel">
                <Border MinHeight="37"
                        Background="#FFFFFF"
                        BorderBrush="#DEE5E8"
                        BorderThickness="0,0,0,1"
                        Padding="8,4">
                  <Grid ColumnDefinitions="42,126,112,104,62,*"
                        ColumnSpacing="8">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Spacing="0"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding EngineeringSignalLabel}"
                                 Foreground="#245E7C"
                                 FontSize="10.4"
                                 FontWeight="Bold" />
                      <TextBlock Text="{Binding SignalLabel}"
                                 Foreground="#82939C"
                                 FontSize="8.2" />
                    </StackPanel>

                    <TextBox Grid.Column="2"
                             Classes="injectionEditor"
                             Text="{Binding RmsText, Mode=TwoWay}" />
                    <TextBox Grid.Column="3"
                             Classes="injectionEditor"
                             Text="{Binding AngleText, Mode=TwoWay}" />

                    <TextBlock Grid.Column="4"
                               Classes="injectionValue"
                               Text="{Binding Unit}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="5"
                                Spacing="0"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding Provenance}"
                                 Foreground="#3D5966"
                                 FontSize="9.5"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ChannelFamily}"
                                 Foreground="#8A9AA2"
                                 FontSize="8.2" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Classes="injectionCard"
            Padding="10,8">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
        <Grid RowDefinitions="Auto,Auto"
              VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <TextBlock Classes="injectionLabel"
                       Text="SOURCE STATUS"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding InjectionEditorStatus}"
                       Foreground="#2D4A58"
                       FontSize="9.7"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding InjectionFingerprintText}"
                       Foreground="#52717F"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       FontSize="9.2"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Row="1"
                     Text="{Binding ProvenanceText}"
                     Foreground="#7A8D96"
                     FontSize="8.8"
                     Margin="0,3,0,0"
                     TextTrimming="CharacterEllipsis" />
        </Grid>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Button Classes="injectionAction primary"
                  Command="{Binding ApplyInjectionCommand}"
                  Content="APPLY CONFIGURED SOURCE" />
          <Button Classes="injectionAction warning"
                  Command="{Binding FaultCommand}"
                  Content="LOAD + START A-G FAULT" />
          <Button Classes="injectionAction"
                  Command="{Binding ClearInjectionCommand}"
                  Content="CLEAR INJECTION" />
          <Button Classes="injectionAction"
                  Command="{Binding ResetRelayCommand}"
                  Content="RESET RELAY" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
