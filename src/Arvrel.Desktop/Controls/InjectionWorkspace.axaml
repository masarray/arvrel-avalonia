<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arvrel.Desktop.ViewModels"
             x:Class="Arvrel.Desktop.Controls.InjectionWorkspace"
             x:DataType="vm:MainWindowViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <UserControl.Resources>
    <DataTemplate x:Key="InjectionChannelRowTemplate"
                  x:DataType="vm:InjectionChannelViewModel">
      <Border MinHeight="45"
              Background="#FFFFFF"
              BorderBrush="#E0E7EA"
              BorderThickness="0,0,0,1"
              Padding="9,5">
        <Grid ColumnDefinitions="38,92,*,88"
              ColumnSpacing="8">
          <CheckBox Grid.Column="0"
                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

          <StackPanel Grid.Column="1"
                      VerticalAlignment="Center"
                      Spacing="0">
            <TextBlock Text="{Binding EngineeringSignalLabel}"
                       Foreground="#1E5F80"
                       FontSize="10.5"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding SignalLabel}"
                       Foreground="#8A9AA2"
                       FontSize="8.2" />
          </StackPanel>

          <Grid Grid.Column="2"
                ColumnDefinitions="*,24">
            <TextBox Classes="injectionEditor"
                     Text="{Binding RmsText, Mode=TwoWay}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Unit}"
                       Foreground="#5E737D"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       FontSize="9.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBox Grid.Column="3"
                   Classes="injectionEditor"
                   Text="{Binding AngleText, Mode=TwoWay}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.testSetCard">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#C7D3D9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="TextBlock.testSetCaption">
      <Setter Property="Foreground" Value="#728690" />
      <Setter Property="FontSize" Value="8.7" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBox.injectionEditor">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="10.3" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.testSetAction">
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="4,7,4,4"
        RowDefinitions="52,8,*,8,48">
    <Border Grid.Row="0"
            Classes="testSetCard"
            Padding="12,7">
      <Grid ColumnDefinitions="*,178,82"
            ColumnSpacing="9">
        <StackPanel VerticalAlignment="Center"
                    Spacing="1">
          <TextBlock Text="SECONDARY INJECTION TEST SET"
                     Foreground="#1D3440"
                     FontSize="13.2"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding InjectionEditorStatus}"
                     Foreground="#6F838D"
                     FontSize="9.2"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Spacing="2">
          <TextBlock Classes="testSetCaption"
                     Text="PRESET" />
          <ComboBox ItemsSource="{Binding PresetNames}"
                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                    MinHeight="29" />
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Spacing="2">
          <TextBlock Classes="testSetCaption"
                     Text="FREQUENCY" />
          <Grid ColumnDefinitions="*,20">
            <TextBox Text="{Binding FrequencyText, Mode=TwoWay}"
                     MinHeight="29"
                     HorizontalContentAlignment="Right" />
            <TextBlock Grid.Column="1"
                       Text="Hz"
                       Foreground="#657B86"
                       FontSize="9"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2"
          ColumnDefinitions="*,8,*">
      <Border Grid.Column="0"
              Classes="testSetCard"
              Padding="0">
        <Grid RowDefinitions="38,27,*">
          <Border Background="#EAF2F6"
                  BorderBrush="#C6D5DC"
                  BorderThickness="0,0,0,1"
                  Padding="10,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="CURRENT OUTPUTS"
                         Foreground="#21485C"
                         FontSize="11.5"
                         FontWeight="Bold"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="4 I"
                         Foreground="#2A779E"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         FontSize="10"
                         FontWeight="Bold"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Row="1"
                  Background="#F7F9FA"
                  Padding="9,0">
            <Grid ColumnDefinitions="38,92,*,88"
                  ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="testSetCaption" Text="ON" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="testSetCaption" Text="CHANNEL" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="testSetCaption" Text="RMS" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="testSetCaption" Text="ANGLE°" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="2"
                        ItemsSource="{Binding CurrentInjectionChannels}"
                        ItemTemplate="{StaticResource InjectionChannelRowTemplate}" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Classes="testSetCard"
              Padding="0">
        <Grid RowDefinitions="38,27,*">
          <Border Background="#EAF2F6"
                  BorderBrush="#C6D5DC"
                  BorderThickness="0,0,0,1"
                  Padding="10,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="VOLTAGE OUTPUTS"
                         Foreground="#21485C"
                         FontSize="11.5"
                         FontWeight="Bold"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="4 V"
                         Foreground="#2A779E"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         FontSize="10"
                         FontWeight="Bold"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Row="1"
                  Background="#F7F9FA"
                  Padding="9,0">
            <Grid ColumnDefinitions="38,92,*,88"
                  ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="testSetCaption" Text="ON" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="testSetCaption" Text="CHANNEL" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="testSetCaption" Text="RMS" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="testSetCaption" Text="ANGLE°" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="2"
                        ItemsSource="{Binding VoltageInjectionChannels}"
                        ItemTemplate="{StaticResource InjectionChannelRowTemplate}" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="4"
            Classes="testSetCard"
            Padding="9,7">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding OutputStateText}"
                     Foreground="#287544"
                     FontSize="9.5"
                     FontWeight="Bold" />
          <TextBlock Text="{Binding InjectionFingerprintText}"
                     Foreground="#5B7380"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="9.2" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Center">
          <Button Classes="testSetAction primary"
                  Command="{Binding ApplyInjectionCommand}"
                  Content="APPLY" />
          <Button Classes="testSetAction warning"
                  Command="{Binding FaultCommand}"
                  Content="A-G FAULT" />
          <Button Classes="testSetAction"
                  Command="{Binding ClearInjectionCommand}"
                  Content="CLEAR" />
          <Button Classes="testSetAction"
                  Command="{Binding ResetRelayCommand}"
                  Content="RESET RELAY" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
