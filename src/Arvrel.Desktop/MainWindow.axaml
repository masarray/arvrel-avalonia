<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Arvrel.Desktop.Controls"
        xmlns:vm="using:Arvrel.Desktop.ViewModels"
        x:Class="Arvrel.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ARVREL — Virtual Protection Relay Laboratory"
        Width="1520"
        Height="900"
        MinWidth="1280"
        MinHeight="760">
  <Grid RowDefinitions="52,60,*,28">
    <Border Grid.Row="0"
            Background="#17232D"
            BorderBrush="#2D3C47"
            BorderThickness="0,0,0,1">
      <Grid Margin="16,0" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="9"
                    VerticalAlignment="Center">
          <Border Width="29"
                  Height="29"
                  CornerRadius="5"
                  Background="#2E6F9E">
            <TextBlock Text="AR"
                       Foreground="White"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Classes="title"
                       Text="{Binding ProductTitle}" />
            <TextBlock Classes="subtitle"
                       Text="{Binding ProductSubtitle}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Border Padding="9,5"
                  CornerRadius="4"
                  Background="#203440"
                  BorderBrush="#355262"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8"
                       Height="8"
                       Fill="#47B46A"
                       VerticalAlignment="Center" />
              <TextBlock Text="{Binding LabStatusText}"
                         Foreground="#C8D5DC"
                         FontSize="10.2"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding EngineStatusText}"
                     Foreground="#758895"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="9.6"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="#F6F8F9"
            BorderBrush="#C8D2D8"
            BorderThickness="0,0,0,1">
      <Grid Margin="13,9"
            ColumnDefinitions="Auto,230,12,Auto,1.08*,12,Auto,1*,12,Auto,128,16,Auto">
        <TextBlock Grid.Column="0"
                   Classes="section"
                   Text="SOURCE"
                   VerticalAlignment="Center"
                   Margin="0,0,7,0" />
        <Border Grid.Column="1"
                Classes="toolbarField">
          <TextBlock Text="{Binding ActiveDisplaySourceText}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Border>

        <TextBlock Grid.Column="3"
                   Classes="section"
                   Text="ADAPTER"
                   VerticalAlignment="Center"
                   Margin="0,0,7,0" />
        <ComboBox Grid.Column="4"
                  MinWidth="190"
                  ToolTip.Tip="Select the capture adapter used by the process-bus workspace"
                  ItemsSource="{Binding ProcessBusAdapters}"
                  SelectedItem="{Binding SelectedProcessBusAdapter, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}"
                         TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Column="6"
                   Classes="section"
                   Text="SV STREAM"
                   VerticalAlignment="Center"
                   Margin="0,0,7,0" />
        <ComboBox Grid.Column="7"
                  MinWidth="190"
                  ToolTip.Tip="Select the IEC 61850 Sampled Values stream presented to the operator"
                  ItemsSource="{Binding ProcessBusStreams}"
                  SelectedItem="{Binding SelectedProcessBusStream, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}"
                         TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Column="9"
                   Classes="section"
                   Text="VIEW"
                   VerticalAlignment="Center"
                   Margin="0,0,7,0" />
        <ComboBox Grid.Column="10"
                  SelectedIndex="0"
                  ToolTip.Tip="Select secondary or primary engineering units">
          <ComboBoxItem Content="Secondary A" />
          <ComboBoxItem Content="Primary A" />
        </ComboBox>

        <StackPanel Grid.Column="12"
                    Orientation="Horizontal"
                    Spacing="5">
          <ToggleButton x:Name="ToolsToggle"
                        Classes="tools"
                        Content="TOOLS"
                        ToolTip.Tip="Open engineering source, relay, process-bus, evidence, and event workspaces" />
          <Button Classes="icon"
                  Command="{Binding RefreshAdaptersCommand}"
                  ToolTip.Tip="Refresh capture adapters">
            <Path Width="17"
                  Height="17"
                  Stretch="Uniform"
                  Fill="#2E7FAF"
                  Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12S7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12S8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
          </Button>
          <Button Classes="icon"
                  Command="{Binding SmvCommand}"
                  ToolTip.Tip="Toggle SMV trust degradation">
            <Path Width="17"
                  Height="17"
                  Stretch="Uniform"
                  Fill="#C28416"
                  Data="M1,21H23L12,2L1,21M13,18H11V16H13V18M13,14H11V10H13V14Z" />
          </Button>
          <Button Classes="icon"
                  Command="{Binding ResetRelayCommand}"
                  ToolTip.Tip="Reset the displayed relay latch and timers">
            <Path Width="17"
                  Height="17"
                  Stretch="Uniform"
                  Fill="#2E7FAF"
                  Data="M13,3C8.03,3 4,7.03 4,12H1L5,16L9,12H6C6,8.13 9.13,5 13,5S20,8.13 20,12S16.87,19 13,19C10.24,19 7.86,17.4 6.72,15.08L5.08,16.72C6.62,19.3 9.44,21 13,21C17.97,21 22,16.97 22,12S17.97,3 13,3Z" />
          </Button>
          <Button Classes="primary"
                  Command="{Binding RunCommand}"
                  Content="{Binding RunButtonText}"
                  MinWidth="132" />
        </StackPanel>
      </Grid>
    </Border>

    <SplitView Grid.Row="2"
               x:Name="WorkspaceSplit"
               DisplayMode="Overlay"
               PanePlacement="Left"
               OpenPaneLength="430"
               CompactPaneLength="0"
               IsPaneOpen="{Binding IsChecked, ElementName=ToolsToggle, Mode=TwoWay}">
      <SplitView.Pane>
        <Border Background="#F7F9FA"
                BorderBrush="#AEBCC4"
                BorderThickness="0,0,1,0"
                Padding="10">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="2,0,2,8">
              <StackPanel Spacing="2">
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           Text="Engineering workspaces" />
                <TextBlock Classes="caption"
                           Text="Source, process bus, settings, evidence, and events" />
              </StackPanel>
              <ToggleButton Grid.Column="1"
                            Classes="tools"
                            IsChecked="{Binding IsChecked, ElementName=ToolsToggle, Mode=TwoWay}"
                            Content="CLOSE" />
            </Grid>

            <TabControl Grid.Row="1">
              <TabItem Header="SOURCE">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="4,8,4,4" Spacing="9">
                    <Border Classes="subtle">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="section" Text="VIRTUAL TEST SET" />
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2E7FAF"
                                   Text="{Binding ProfileNameText}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="caption"
                                     Text="{Binding OutputStateText}" />
                          <TextBlock Grid.Column="1"
                                     Classes="engineering"
                                     Text="{Binding InjectionFingerprintText}" />
                        </Grid>
                        <TextBlock Classes="caption"
                                   Text="{Binding ProvenanceText}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,120" ColumnSpacing="8">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="section" Text="PRESET" />
                        <ComboBox ItemsSource="{Binding PresetNames}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="section" Text="FREQUENCY Hz" />
                        <TextBox Text="{Binding FrequencyText, Mode=TwoWay}"
                                 HorizontalContentAlignment="Right" />
                      </StackPanel>
                    </Grid>

                    <Button Classes="primary"
                            Command="{Binding ApplyInjectionCommand}"
                            Content="APPLY CONFIGURED SOURCE" />
                    <Button Classes="warning"
                            Command="{Binding FaultCommand}"
                            Content="{Binding FaultButtonText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                      <Button Grid.Column="0"
                              Command="{Binding ClearInjectionCommand}"
                              Content="CLEAR INJECTION" />
                      <Button Grid.Column="1"
                              Command="{Binding SmvCommand}"
                              Content="{Binding SmvButtonText}" />
                    </Grid>
                    <Button Command="{Binding ResetLaboratoryCommand}"
                            Content="RESET COMPLETE LAB" />

                    <Border Classes="subtle">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="section" Text="SOURCE STATUS" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding InjectionEditorStatus}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="caption"
                                   Text="{Binding StatusText}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>

                    <TextBlock Classes="section"
                               Text="EDITABLE 4I + 4V"
                               Margin="0,5,0,0" />
                    <Grid ColumnDefinitions="30,50,*,*,66"
                          ColumnSpacing="5"
                          Margin="4,0">
                      <TextBlock Grid.Column="0" Classes="caption" Text="ON" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="SIG" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="RMS" />
                      <TextBlock Grid.Column="3" Classes="caption" Text="ANGLE°" />
                      <TextBlock Grid.Column="4" Classes="caption" Text="SOURCE" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding InjectionChannels}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InjectionChannelViewModel">
                          <Border Classes="subtle"
                                  Margin="0,0,0,5"
                                  Padding="7">
                            <Grid ColumnDefinitions="30,50,*,*,66"
                                  ColumnSpacing="5">
                              <CheckBox Grid.Column="0"
                                        IsChecked="{Binding Enabled, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1"
                                          VerticalAlignment="Center">
                                <TextBlock FontWeight="Bold"
                                           Foreground="#2E7FAF"
                                           Text="{Binding SignalLabel}" />
                                <TextBlock Classes="caption"
                                           Text="{Binding Unit}" />
                              </StackPanel>
                              <TextBox Grid.Column="2"
                                       Text="{Binding RmsText, Mode=TwoWay}"
                                       HorizontalContentAlignment="Right" />
                              <TextBox Grid.Column="3"
                                       Text="{Binding AngleText, Mode=TwoWay}"
                                       HorizontalContentAlignment="Right" />
                              <TextBlock Grid.Column="4"
                                         Classes="caption"
                                         Text="{Binding Provenance}"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="PROCESS BUS">
                <controls:ProcessBusWorkspace Margin="4,8,4,4" />
              </TabItem>

              <TabItem Header="RELAY">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="4,8,4,4" Spacing="9">
                    <Border Classes="subtle">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="section"
                                       Text="ACTIVE SETTING GROUP" />
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2E7FAF"
                                       Text="{Binding SettingsGroupText}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Classes="engineering"
                                     Text="{Binding SettingsFingerprintText}"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                          <StackPanel Spacing="3">
                            <TextBlock Classes="caption" Text="GROUP NAME" />
                            <TextBox Text="{Binding SettingsEditor.GroupName, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Classes="caption" Text="REVISION" />
                            <TextBox Text="{Binding SettingsEditor.RevisionText, Mode=TwoWay}"
                                     HorizontalContentAlignment="Right" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="subtle">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock FontWeight="Bold"
                                     Foreground="#2E7FAF"
                                     Text="50P" />
                          <TextBlock Grid.Column="1"
                                     Margin="8,0"
                                     Classes="caption"
                                     Text="PHASE INSTANTANEOUS" />
                          <CheckBox Grid.Column="2"
                                    Content="ENABLED"
                                    IsChecked="{Binding SettingsEditor.Phase50.Enabled, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="PICKUP A" />
                            <TextBox Text="{Binding SettingsEditor.Phase50.PickupText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="caption" Text="DELAY ms" />
                            <TextBox Text="{Binding SettingsEditor.Phase50.DelayMsText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Classes="caption" Text="DROPOUT" />
                            <TextBox Text="{Binding SettingsEditor.Phase50.DropoutText, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="subtle">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock FontWeight="Bold"
                                     Foreground="#2E7FAF"
                                     Text="51P" />
                          <TextBlock Grid.Column="1"
                                     Margin="8,0"
                                     Classes="caption"
                                     Text="PHASE TIME" />
                          <CheckBox Grid.Column="2"
                                    Content="ENABLED"
                                    IsChecked="{Binding SettingsEditor.Phase51.Enabled, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="PICKUP A" />
                            <TextBox Text="{Binding SettingsEditor.Phase51.PickupText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="caption" Text="CURVE" />
                            <ComboBox ItemsSource="{Binding SettingsEditor.CurveFamilies}"
                                      SelectedItem="{Binding SettingsEditor.Phase51.Curve, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="TMS" />
                            <TextBox Text="{Binding SettingsEditor.Phase51.MultiplierText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="caption" Text="DEFINITE ms" />
                            <TextBox Text="{Binding SettingsEditor.Phase51.DefiniteDelayMsText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Classes="caption" Text="MIN OP ms" />
                            <TextBox Text="{Binding SettingsEditor.Phase51.MinimumOperateMsText, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="subtle">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock FontWeight="Bold"
                                     Foreground="#2E7FAF"
                                     Text="50N" />
                          <TextBlock Grid.Column="1"
                                     Margin="8,0"
                                     Classes="caption"
                                     Text="EARTH INSTANTANEOUS" />
                          <CheckBox Grid.Column="2"
                                    Content="ENABLED"
                                    IsChecked="{Binding SettingsEditor.Earth50.Enabled, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="PICKUP A" />
                            <TextBox Text="{Binding SettingsEditor.Earth50.PickupText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="caption" Text="DELAY ms" />
                            <TextBox Text="{Binding SettingsEditor.Earth50.DelayMsText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Classes="caption" Text="DROPOUT" />
                            <TextBox Text="{Binding SettingsEditor.Earth50.DropoutText, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="subtle">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock FontWeight="Bold"
                                     Foreground="#2E7FAF"
                                     Text="51N" />
                          <TextBlock Grid.Column="1"
                                     Margin="8,0"
                                     Classes="caption"
                                     Text="EARTH TIME" />
                          <CheckBox Grid.Column="2"
                                    Content="ENABLED"
                                    IsChecked="{Binding SettingsEditor.Earth51.Enabled, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="PICKUP A" />
                            <TextBox Text="{Binding SettingsEditor.Earth51.PickupText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="caption" Text="CURVE" />
                            <ComboBox ItemsSource="{Binding SettingsEditor.CurveFamilies}"
                                      SelectedItem="{Binding SettingsEditor.Earth51.Curve, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="caption" Text="TMS" />
                            <TextBox Text="{Binding SettingsEditor.Earth51.MultiplierText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="caption" Text="DEFINITE ms" />
                            <TextBox Text="{Binding SettingsEditor.Earth51.DefiniteDelayMsText, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Classes="caption" Text="MIN OP ms" />
                            <TextBox Text="{Binding SettingsEditor.Earth51.MinimumOperateMsText, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Button Classes="primary"
                            Command="{Binding ApplySettingsCommand}"
                            Content="VALIDATE + APPLY RELAY SETTINGS" />
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding SettingsEditorStatus}"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="caption"
                               Text="Applying relay settings resets timers and the trip latch while preserving the source."
                               TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="EVIDENCE">
                <controls:EvidenceWorkspace Margin="4,8,4,4" />
              </TabItem>

              <TabItem Header="EVENTS">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Margin="4,8,4,4">
                  <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock FontFamily="Cascadia Mono,Consolas,monospace"
                                   FontSize="10"
                                   Foreground="#526973"
                                   Text="{Binding}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,7" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid Margin="11"
              ColumnDefinitions="1.72*,9,0.92*">
          <Grid Grid.Column="0"
                RowDefinitions="*,9,204">
            <Border Grid.Row="0"
                    Classes="panel"
                    Padding="0">
              <Grid RowDefinitions="52,*,39">
                <Border Grid.Row="0"
                        BorderBrush="#D0D9DE"
                        BorderThickness="0,0,0,1"
                        Padding="13,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="SMV waveform"
                                   FontSize="13.5"
                                   FontWeight="SemiBold" />
                        <Border Padding="6,2"
                                CornerRadius="4"
                                Background="#E8F3F9">
                          <TextBlock Text="2 CYCLES"
                                     Foreground="#2E7FAF"
                                     FontSize="9.3"
                                     FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding StreamRunStateText}"
                                   Foreground="#2B9B55"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="caption"
                                 Text="{Binding ActiveDisplaySourceText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="20"
                                VerticalAlignment="Center">
                      <StackPanel>
                        <TextBlock Classes="section" Text="IA" />
                        <TextBlock Classes="measurement" Text="{Binding PhaseAText}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Classes="section" Text="IB" />
                        <TextBlock Classes="measurement" Text="{Binding PhaseBText}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Classes="section" Text="IC" />
                        <TextBlock Classes="measurement" Text="{Binding PhaseCText}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Classes="section" Text="3I0 / IN" />
                        <TextBlock Classes="measurement" Text="{Binding ResidualText}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <TabControl Grid.Row="1"
                            SelectedIndex="2"
                            Margin="10,5,10,0">
                  <TabItem Header="INJECT">
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="4,8">
                      <StackPanel VerticalAlignment="Center" Spacing="7">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProfileNameText}" />
                        <TextBlock Classes="caption"
                                   Text="{Binding InjectionEditorStatus}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="engineering"
                                   Text="{Binding InjectionFingerprintText}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="7"
                                  VerticalAlignment="Center">
                        <Button Classes="warning"
                                Command="{Binding FaultCommand}"
                                Content="⚡ Inject A-G fault" />
                        <Button Command="{Binding SmvCommand}"
                                Content="🛡 Degrade SMV" />
                        <Button Command="{Binding ResetLaboratoryCommand}"
                                Content="↺ Reset" />
                      </StackPanel>
                    </Grid>
                  </TabItem>

                  <TabItem Header="WAVE">
                    <Border Classes="darkPanel"
                            Margin="4,8,4,4"
                            Padding="5">
                      <controls:WaveformScope Waveform="{Binding Waveform}"
                                              MinHeight="320" />
                    </Border>
                  </TabItem>

                  <TabItem Header="DUAL">
                    <Grid ColumnDefinitions="2.02*,8,1*"
                          Margin="4,8,4,4">
                      <Border Grid.Column="0"
                              Classes="darkPanel"
                              Padding="5">
                        <controls:WaveformScope Waveform="{Binding Waveform}"
                                                MinHeight="320" />
                      </Border>
                      <Border Grid.Column="2"
                              Classes="darkPanel">
                        <controls:PhasorScope Frame="{Binding PhasorFrame}"
                                              MinHeight="320" />
                      </Border>
                    </Grid>
                  </TabItem>

                  <TabItem Header="PHASOR">
                    <Border Classes="darkPanel"
                            Margin="4,8,4,4">
                      <controls:PhasorScope Frame="{Binding PhasorFrame}"
                                            MinHeight="320" />
                    </Border>
                  </TabItem>
                </TabControl>

                <Border Grid.Row="2"
                        BorderBrush="#D0D9DE"
                        BorderThickness="0,1,0,0"
                        Padding="11,0">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="engineering"
                               FontWeight="SemiBold"
                               Text="{Binding FrequencyTextDisplay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="caption"
                               Text="  ·  "
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="caption"
                               Text="{Binding WindowText}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Classes="engineering"
                               Text="{Binding SampleCounterText}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center">
                      <Button Classes="compact warning"
                              Command="{Binding FaultCommand}"
                              Content="⚡ Inject A-G fault" />
                      <Button Classes="compact"
                              Command="{Binding SmvCommand}"
                              Content="🛡 Degrade SMV" />
                      <Button Classes="compact"
                              Command="{Binding ResetRelayCommand}"
                              Content="↺ Reset" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Row="2"
                    Classes="panel"
                    Padding="0">
              <Grid RowDefinitions="42,*">
                <Border Grid.Row="0"
                        BorderBrush="#D0D9DE"
                        BorderThickness="0,0,0,1"
                        Padding="12,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <TextBlock Text="Protection operation"
                                 FontSize="12.5"
                                 FontWeight="SemiBold" />
                      <TextBlock Classes="caption"
                                 Text="{Binding OperationHeaderText}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="9,4"
                            CornerRadius="4"
                            Background="#EEF4F7"
                            BorderBrush="#BCD0DA"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding OperationBadgeText}"
                                 Foreground="#365D70"
                                 FontSize="9.2"
                                 FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="1.28*,2.42*,1.55*"
                      ColumnSpacing="8"
                      Margin="11,8">
                  <Border Grid.Column="0"
                          DataContext="{Binding PrimaryProtectionElement}"
                          Background="#EEF5F8"
                          BorderBrush="#8CB8CF"
                          BorderThickness="1"
                          CornerRadius="5"
                          Padding="9">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="1">
                          <TextBlock Text="PRIMARY OPERATION"
                                     Foreground="#66818F"
                                     FontSize="8.8"
                                     FontWeight="Bold" />
                          <TextBlock Text="{Binding Label}"
                                     Foreground="#526C78"
                                     FontSize="9.2"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="#D7EAF3"
                                CornerRadius="4"
                                Padding="7,4">
                          <TextBlock Text="{Binding Code}"
                                     Foreground="#1E6D96"
                                     FontFamily="Cascadia Mono,Consolas,monospace"
                                     FontSize="12"
                                     FontWeight="Bold" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Text="{Binding StateText}"
                                 Foreground="#D64248"
                                 FontSize="13"
                                 FontWeight="Bold" />
                      <ProgressBar Grid.Row="2"
                                   Margin="0,6,0,0"
                                   Minimum="0"
                                   Maximum="1"
                                   Value="{Binding Progress}"
                                   MinHeight="6" />
                      <TextBlock Grid.Row="3"
                                 Margin="0,7,0,0"
                                 Classes="caption"
                                 Text="{Binding Detail}"
                                 TextWrapping="Wrap"
                                 MaxHeight="50" />
                      <TextBlock Grid.Row="4"
                                 Margin="0,5,0,0"
                                 Foreground="#66818F"
                                 FontSize="8.5"
                                 Text="Selected from active element and timing progress" />
                    </Grid>
                  </Border>

                  <ItemsControl Grid.Column="1"
                                ItemsSource="{Binding SecondaryProtectionElements}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProtectionElementViewModel">
                        <Border Background="#F6F8F9"
                                BorderBrush="#D6DEE2"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="0,0,8,0"
                                Padding="8">
                          <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Label}"
                                         Foreground="#6B7F8A"
                                         FontSize="8.8"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Code}"
                                         Foreground="#38505C"
                                         FontFamily="Cascadia Mono,Consolas,monospace"
                                         FontSize="10.5"
                                         FontWeight="Bold" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Margin="0,7,0,0"
                                       Foreground="#C13B42"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Text="{Binding StateText}" />
                            <ProgressBar Grid.Row="2"
                                         Margin="0,5,0,0"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="{Binding Progress}" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,6,0,0"
                                       Classes="caption"
                                       FontSize="8.8"
                                       Text="{Binding Detail}"
                                       TextWrapping="Wrap"
                                       MaxHeight="58" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Grid.Column="2"
                          Background="#F7F9FA"
                          BorderBrush="#D3DDE2"
                          BorderThickness="1"
                          CornerRadius="5"
                          Padding="9">
                    <Grid RowDefinitions="Auto,*">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock Classes="section"
                                   Text="EVENT TRACE" />
                        <TextBlock Grid.Column="1"
                                   Text="LATEST FIRST"
                                   Foreground="#8A9AA3"
                                   FontSize="8.2" />
                      </Grid>
                      <ScrollViewer Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Events}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock FontFamily="Cascadia Mono,Consolas,monospace"
                                         FontSize="9"
                                         Foreground="#526973"
                                         Text="{Binding}"
                                         TextWrapping="Wrap"
                                         Margin="0,0,0,4" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Column="2"
                  Background="#050708"
                  BorderBrush="#0D1114"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="10">
            <controls:VirtualRelayFaceplate />
          </Border>
        </Grid>
      </SplitView.Content>
    </SplitView>

    <Border Grid.Row="3"
            Background="#EEF3F5"
            BorderBrush="#C7D1D7"
            BorderThickness="0,1,0,0">
      <Grid Margin="11,0" ColumnDefinitions="*,Auto">
        <TextBlock Classes="caption"
                   Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1"
                   Classes="engineering"
                   Text="{Binding FooterStatusText}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
